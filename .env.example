# Copy to .env (same folder) and fill in. .env is git-ignored. Restart the API after editing.
# Anything set in the real environment or a vault wins over this file.
# Check the result with:  cd services/api && python -m asdp.cli doctor

# --- which policy file to use
ASDP_POLICY_PATH=config/policy.office.example.yaml

# --- Jira (pick the block that matches jira.source in the policy file)
ASDP_JIRA_BASE_URL=
# Jira Cloud (jira.source: cloud): the account email and an API token for that account
ASDP_JIRA_EMAIL=
# Jira Cloud: API token.  Jira Data Center (jira.source: datacenter): personal access token
ASDP_JIRA_API_TOKEN=
# Sprint custom field id. customfield_10020 is the Jira Cloud default; Data Center is often different
ASDP_JIRA_SPRINT_FIELD=customfield_10020
# Only if acceptance criteria live in their own custom field instead of the description
ASDP_JIRA_CRITERIA_FIELD=
# Shared secret for the optional Jira webhook
ASDP_WEBHOOK_SECRET=

# --- Devin (only needed when agents.devin_api_enabled: true; manual mode needs no key)
ASDP_DEVIN_API_KEY=
ASDP_DEVIN_API_BASE=https://api.devin.ai/v1

# --- Git and CI
ASDP_GITHUB_WEBHOOK_SECRET=
ASDP_AUTOMATION_TOKEN=

# --- running it for more than one person (docs/production.md). With ASDP_DEV_MODE=false the
# server refuses to start until ASDP_SECRET, ASDP_AUTH_MODE=proxy and ASDP_PROXY_SECRET are set.
ASDP_SECRET=
ASDP_PUBLIC_BASE_URL=http://localhost:8000
ASDP_PORTAL_ORIGIN=http://localhost:5173
# ASDP_DEV_MODE=false
# ASDP_AUTH_MODE=proxy
# ASDP_PROXY_SECRET=
# ASDP_SERVE_PORTAL=true
# ASDP_DATABASE_URL=postgresql+psycopg://user:password@host/asdp

# --- pull / push from a repository (python -m asdp.cli)
ASDP_API_URL=http://localhost:8000
ASDP_USER=
